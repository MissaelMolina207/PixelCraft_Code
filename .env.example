# ===== Estudio IA: motor GRATIS (recomendado) — Cloudflare Workers AI =====
# FLUX.2 klein 4B (imagen + referencias) y un LLM chico que mejora el prompt. 10,000 neuronas/día sin costo.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Opcionales:
# IMAGE_PROVIDER=cloudflare        # cloudflare | google | replicate (por defecto: el primero que tenga credenciales)
# CF_IMAGE_MODEL=klein             # klein (default) | schnell (plan B: solo texto, sin imágenes del cliente)
# CF_LLM_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8-fast

# ===== Render HD (de pago, opcional) — activa el botón "Render HD" =====
# Gemini API (Nano Banana 2.1, ~US$0.034 por imagen 1K). Key en https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
# Alternativa: Replicate (nano-banana)
REPLICATE_API_TOKEN=
# PREMIUM_PROVIDER=google          # google | replicate
# HD_DAILY_CAP=30                  # tope diario de renders HD por instancia. 0 = sin botón HD

STRIPE_SECRET_KEY=
N8N_LEAD_WEBHOOK=
