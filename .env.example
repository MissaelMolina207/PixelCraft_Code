# ===== Estudio IA: motor GRATIS (recomendado) — Cloudflare Workers AI =====
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# IMAGE_PROVIDER=cloudflare        # cloudflare | google | replicate
# CF_IMAGE_MODEL=klein             # klein (default) | schnell (plan B: solo texto)

# ===== Render HD (de pago, opcional) =====
GEMINI_API_KEY=
# PREMIUM_PROVIDER=google          # google | replicate
# HD_DAILY_CAP=30                  # tope diario de renders HD. 0 = sin botón HD
REPLICATE_API_TOKEN=

# ===== Rastreo + Admin (base de datos Cloudflare D1, gratis) =====
# Crea una base D1 en el dashboard de Cloudflare y copia su ID. El token necesita permiso Account > D1 > Edit
# (puedes añadírselo al token de Workers AI y reutilizarlo, o crear uno aparte en CLOUDFLARE_D1_TOKEN).
CLOUDFLARE_D1_DATABASE_ID=
# CLOUDFLARE_D1_TOKEN=
# Contraseña del panel /admin: MÍNIMO 10 caracteres. Sin ella el login se desactiva.
ADMIN_PASSWORD=
# Opcional: secreto para firmar la sesión (si no, se deriva de ADMIN_PASSWORD; cambiar la contraseña cierra todas las sesiones)
# ADMIN_SECRET=

# ===== Marketplaces vía n8n =====
# Token para que n8n registre ventas de Mercado Libre/Amazon/Facebook y lea el stock a publicar. MÍNIMO 24 caracteres.
# Genera uno largo y aleatorio. Sin él, /api/channels responde 503 (puerta cerrada).
INTAKE_TOKEN=

STRIPE_SECRET_KEY=
N8N_LEAD_WEBHOOK=
