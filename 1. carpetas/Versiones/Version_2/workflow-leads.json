    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "// Entrada: multipart del front. Campos en $json.body; el archivo (si hay) en $binary.\nconst item = $input.first();\nconst b = item.json.body ?? {};\nconst esClic = b.tipo === 'clic_whatsapp';                 // evento de tracking, no es lead\nconst whatsapp = String(b.whatsapp ?? '').replace(/\\D/g, '');\n\nlet error = '';\nif (b.website) error = 'bot';                                                 // honeypot lleno\nelse if (!esClic && !b.nombre) error = 'nombre';\nelse if (!esClic && !/^\\d{10,13}$/.test(whatsapp)) error = 'whatsapp';\nelse if (!esClic && !/^\\S+@\\S+\\.\\S+$/.test(b.correo ?? '')) error = 'correo';\n\nreturn [{\n  json: {\n    valido: !error, error, esClic,\n    folio: 'PX-' + Date.now().toString(36).toUpperCase(),\n    fecha: b.fecha ?? new Date().toISOString(),\n    nombre: b.nombre ?? '', whatsapp, correo: b.correo ?? '',\n    tipo: b.tipo ?? '', producto: b.producto ?? '', mensaje: b.mensaje ?? '',\n    direccion: b.direccion ?? '', urlArte: b.urlArte ?? '', detalle: b.detalle ?? '',\n    tieneArchivo: Object.keys(item.binary ?? {}).length > 0,\n  },\n  binary: item.binary,   // el logo subido viaja hasta aquí: súbelo a Drive con un nodo Google Drive\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "Normalizar y validar"
    },
