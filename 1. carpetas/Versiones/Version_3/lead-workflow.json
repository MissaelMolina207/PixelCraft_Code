{
  "name": "PixelCraft - Lead de pieza muestra",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "pixelcraft-lead",
        "options": { "allowedOrigins": "https://TU-DOMINIO.com" }
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "name": "Lead (Webhook)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "pixelcraft-lead"
    },
    {
      "parameters": {
        "resource": "card",
        "operation": "create",
        "listId": "TU_ID_DE_LISTA_TRELLO",
        "name": "={{ $json.body.nombre }} - {{ $json.body.producto }}",
        "additionalFields": {
          "description": "=Tipo: {{ $json.body.tipo }}\nCorreo: {{ $json.body.email }}\n\n{{ $json.body.mensaje }}"
        }
      },
      "id": "a1b2c3d4-0002-4000-8000-000000000002",
      "name": "Tarjeta en Trello",
      "type": "n8n-nodes-base.trello",
      "typeVersion": 1,
      "position": [280, 0],
      "credentials": { "trelloApi": { "id": "", "name": "Trello account" } }
    },
    {
      "parameters": {
        "content": "El mockup llega como binario `mockup` (multipart).\nSiguiente paso: nodo Google Drive > Upload con ese campo y enlace del archivo en la tarjeta.\n\nAntes de producción: cambia Allowed Origins por tu dominio real (CORS) y el listId de Trello."
      },
      "id": "a1b2c3d4-0003-4000-8000-000000000003",
      "name": "Notas",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [0, 200]
    }
  ],
  "connections": {
    "Lead (Webhook)": { "main": [[{ "node": "Tarjeta en Trello", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
